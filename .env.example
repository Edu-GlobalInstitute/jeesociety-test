# ---- Database (Neon) ------------------------------------------------------
# Local: docker compose up -d postgres  (leave both URLs at the values below)
#
# Production is a Neon branch, which gives you two connection strings for the
# same database. Copy BOTH from the Neon console — the difference is not
# cosmetic:
#
#   DATABASE_URL           ...-pooler.ap-southeast-1.aws.neon.tech  PgBouncer
#   DATABASE_URL_UNPOOLED  ...ap-southeast-1.aws.neon.tech          direct
#
# Everything at request time uses the pooled one. The direct one is used by
# `pnpm migrate` (advisory locks and DDL) and by the worker's pg_dump backup,
# none of which survive transaction pooling. Setting only DATABASE_URL to a
# -pooler host is handled — the direct host is derived by dropping `-pooler` —
# but set both explicitly in production so nothing depends on that guess.
DATABASE_URL=postgres://jee:jee@localhost:5433/jee
DATABASE_URL_UNPOOLED=postgres://jee:jee@localhost:5433/jee
# Per-process pool size. PgBouncer multiplexes onto the compute's own
# max_connections, so this is a throughput knob rather than the hard ceiling it
# was on a single instance — but keep an eye on Neon's connection graph after
# any replica-count change. See SYSTEM_DESIGN.md s10.
PG_POOL_MAX=15
# Development-only escape hatch for a self-signed Postgres proxy. Both services
# refuse to boot with this set in production: unverified TLS to a database on
# the public internet is encryption without authentication.
# PGSSL_NO_VERIFY=false

# ---- API ------------------------------------------------------------------
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
# Better Auth
# Signs session cookies. At least 32 characters; generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating it signs every student out, so never rotate it near the event.
BETTER_AUTH_SECRET=dev-secret-change-me-at-least-32-chars-long
# Base URL of this API, as the browser reaches it — not localhost in
# production, and not the exam client's origin. Auth mounts under it at
# /auth (see basePath in apps/api/src/auth.ts), so the sign-in endpoint is
# ${BETTER_AUTH_URL}/auth/sign-in/email. A mismatch here is not a startup
# error: it surfaces as cookies that are set but never sent back.
BETTER_AUTH_URL=http://localhost:3000
# Trust N proxy hops for client IP (the Railway edge in front of the API = 1).
# Never set to `true`.
TRUST_PROXY_HOPS=1

# ---- Razorpay -------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Cloudflare R2 (paper blob + backups) ---------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=jee-papers
R2_PUBLIC_BASE_URL=https://cdn.example.org

# ---- Worker ---------------------------------------------------------------
# Comma-separated list of loops to run in this process.
# autosubmit,flags,payments,backup
#
# There is no grading loop and no model API key: the paper is 75 objective
# questions marked against tests.answer_key by the mcq_score job.
WORKER_JOBS=autosubmit,flags,payments
BACKUP_INTERVAL_MINUTES=15
