# ---- Database -------------------------------------------------------------
# Local: docker compose up -d postgres
DATABASE_URL=postgres://jee:jee@localhost:5433/jee
# Per-process pool ceiling. replicas x PG_POOL_MAX must stay under the Postgres
# connection limit (default 100). 4 api replicas x 15 = 60. See SYSTEM_DESIGN.md s10.
PG_POOL_MAX=15

# ---- API ------------------------------------------------------------------
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
# Better Auth
BETTER_AUTH_SECRET=dev-secret-change-me-at-least-32-chars-long
BETTER_AUTH_URL=http://localhost:3000
# Trust N proxy hops for client IP (Railway edge = 1). Never set to `true`.
TRUST_PROXY_HOPS=1

# ---- Razorpay -------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Cloudflare R2 (paper blob + backups) ---------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=jee-papers
R2_PUBLIC_BASE_URL=https://cdn.example.org

# ---- Grading model --------------------------------------------------------
# Either anthropic or gemini. temperature is pinned to 0 in code.
GRADING_PROVIDER=anthropic
GRADING_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GRADING_CONCURRENCY=10

# ---- Worker ---------------------------------------------------------------
# Comma-separated list of loops to run in this process.
# autosubmit,flags,payments,grading,backup
WORKER_JOBS=autosubmit,flags,payments,grading
BACKUP_INTERVAL_MINUTES=15
